# PaperTrail — every config key, no values. Never create a real .env from this
# by filling in placeholders; copy it and set real values locally only.
#
# System is Groq-only (docs/costs.md, checked 2026-09-24 — Google AI Studio
# requires billing for any free-tier access). Do not add a second provider
# speculatively.

# --- Provider ---
GROQ_API_KEY=

# --- Model routing ---
# No defaults anywhere in config.py — an unset model fails at startup.
# Real IDs and the reasoning behind each pin: docs/costs.md ("Chosen routing").
MODEL_LARGE=
MODEL_SMALL=
MODEL_JUDGE=
MODEL_FALLBACK=

# --- Embeddings ---
EMBEDDING_MODEL=
EMBEDDING_DIM=

# --- Neo4j ---
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# --- Local storage ---
SQLITE_PATH=
CHECKPOINT_PATH=

# --- Retrieval ---
RETRIEVAL_K=
RETRIEVAL_OVERFETCH=
RRF_K=
EXPAND_ENABLED=
EXPAND_MAX_HOPS=
EXPAND_MIN_SCORE=
GATE_MIN_RELEVANT=
PREFILTER_MIN_SCORE=

# --- Agent bounds ---
MAX_STEPS=
MAX_REVISIONS=
MAX_EXPANSIONS=

# --- Budget envelope ---
# PROVISIONAL: BUDGET_MAX_OUTPUT_TOKENS was sized for non-reasoning models.
# Phase 1's live audit (`make audit-budgets`) re-derives the whole envelope,
# not just per-task max_tokens. Do not treat these as final until it has run.
BUDGET_MAX_INPUT_TOKENS=
BUDGET_MAX_OUTPUT_TOKENS=
BUDGET_MAX_LLM_CALLS=
BUDGET_MAX_COST_USD=
BUDGET_DEADLINE_S=

# --- Observability ---
# Optional. Must never be load-bearing: a Langfuse outage or quota exhaustion
# must never fail a request or a CI run.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Eval ---
EVAL_SMOKE_SIZE=
